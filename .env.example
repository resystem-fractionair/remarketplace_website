# Public URL (used for QR codes, sitemap and the reID redirect URI)
SITE_URL=https://remarketplace.store
SESSION_SECRET=change-me-to-a-long-random-string

# reID sign-in (OAuth 2.0 / OIDC). Redirect URI to register: ${SITE_URL}/api/auth/reid/callback
REID_CLIENT_ID=
REID_CLIENT_SECRET=
REID_AUTH_URL=
REID_TOKEN_URL=
REID_USERINFO_URL=
REID_SCOPE=openid profile email

# Optional: POST every demo booking as JSON to this URL (Zapier/Make/n8n/Slack/CRM)
BOOKING_WEBHOOK_URL=

# Admin console (/admin)
ADMIN_PASSWORD=

# Product storage (required for the admin on Vercel). Without these, data/*.json is used (local dev only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=rm-images

# Booking emails (SMTP). Both info@remarketplace.store and the customer get an HTML email + calendar invite.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=reMarketplace <info@remarketplace.store>
